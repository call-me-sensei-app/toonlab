# Local Postgres. `npm run setup` starts the bundled Compose service when this
# URL is used; point DATABASE_URL at an existing Postgres instance instead if
# preferred.
DATABASE_URL=postgresql://toonlab:toonlab@127.0.0.1:55432/toonlab
TOONLAB_BIND_HOST=127.0.0.1

# Optional public asset CDN. Official catalog seed URLs point at immutable
# objects below official/<release>/<asset-id>/.
R2_PUBLIC_BASE_URL=https://assets.toonlab.io

# Provider keys are read only by the local Node server and are never returned
# to browser code. Configure only providers you want enabled.
TRIPO_API_KEY=
MESHY_API_KEY=
MESHY_API_KEYS=
GEMINI_API_KEY=
FAL_KEY=
OPENAI_API_KEY=
ARK_API_KEY=
POLYPIZZA_API_KEY=
