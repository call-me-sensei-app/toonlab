    "fixedFrameCount": 60,
    "capturePrimeCount": 2,
    "repeatCount": 2,
    "contentThresholds": {
      "maxClippedPixelRatio": 0.18,
      "minNonBlackPixelRatio": 0.1,
      "minLumaStandardDeviation": 8
