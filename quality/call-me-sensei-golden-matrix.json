      "p95DeltaE": 8,
      "pixelRatioAboveDeltaE": 0.04,
      "pixelDeltaE": 6,
      "ssim": 0.985
    }
  },
  "axes": {
    "renderers": ["webgpu", "webgl"],
    "qualities": ["balanced", "performance"],
    "timesOfDay": ["noon", "sunset", "moonlit", "overcast"],
    "cameras": ["near", "medium", "far"]
  },
