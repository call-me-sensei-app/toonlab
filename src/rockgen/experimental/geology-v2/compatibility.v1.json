{
  "schema": "toonlab/rock-geology-compatibility",
  "version": 1,
  "status": "repository-only-draft",
  "statusOrder": ["valid", "valid-but-uncommon", "invalid", "fantastical-explicit-override"],
  "strictDefault": "invalid",
  "overrideContract": {
    "requires": ["allowFantasticalOverride", "overrideReason", "author"],
    "neverRewritesDeclaredGeology": true,
    "outputLabel": "non-physical-art-directed"
  },
  "selectorSemantics": "selectors are OR; fields inside one selector are AND; tagsAny is OR within the tag field; unmatched pairs are invalid",
  "matrixAxes": [
    ["lithology", "fabric"],
    ["lithology", "process"],
    ["lithology", "landform"],
    ["environment", "landform"],
    ["landform", "scale"]
  ],
  "profiles": {
    "fabric": [
      { "id": "massive", "members": ["massive"], "validWhen": [{ "any": true }] },
      { "id": "fine-granular", "members": ["fine-granular"], "validWhen": [{ "classes": ["igneous", "metamorphic"] }], "uncommonWhen": [{ "classes": ["sedimentary"] }] },
      { "id": "medium-granular", "members": ["medium-granular"], "validWhen": [{ "classes": ["igneous", "metamorphic"] }], "uncommonWhen": [{ "lithologies": ["gypsum", "anhydrite", "halite"] }] },
      { "id": "coarse-granular", "members": ["coarse-granular"], "validWhen": [{ "lithologies": ["granite", "alkali-granite", "granodiorite", "tonalite", "syenite", "diorite", "gabbro", "pegmatite", "peridotite", "dunite", "anorthosite", "gneiss", "migmatite", "marble", "quartzite", "amphibolite", "granulite", "eclogite"] }] },
      { "id": "very-coarse-granular", "members": ["very-coarse-granular"], "validWhen": [{ "lithologies": ["pegmatite"] }], "uncommonWhen": [{ "lithologies": ["granite", "alkali-granite", "gabbro"] }] },
      { "id": "porphyritic", "members": ["porphyritic"], "validWhen": [{ "lithologies": ["andesite", "dacite", "rhyolite"] }], "uncommonWhen": [{ "lithologies": ["basalt", "dolerite", "granite"] }] },
      { "id": "volcanic-glass", "members": ["glassy"], "validWhen": [{ "lithologies": ["obsidian"] }], "uncommonWhen": [{ "lithologies": ["rhyolite", "dacite", "pumice"] }] },
      { "id": "vesicular", "members": ["vesicular", "amygdaloidal"], "validWhen": [{ "lithologies": ["basalt", "andesite", "dacite", "rhyolite", "pumice", "scoria", "tuff", "ignimbrite", "volcanic-breccia"] }] },
      { "id": "pillow", "members": ["pillow"], "validWhen": [{ "lithologies": ["basalt"] }], "uncommonWhen": [{ "lithologies": ["greenstone"] }] },
