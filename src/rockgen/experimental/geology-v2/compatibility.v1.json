      "sources": ["paris-implicit-terrain-2019"],
      "evaluator": "seaStackRequiresCoastalHistory",
      "accept": [{ "name": "joint-controlled stack", "recipe": { "lithology": "quartz-arenite", "landform": "sea-stack", "environment": "coastal", "processes": ["marine-abrasion"], "parentCoastId": "headland-a", "collapseStage": "stack" } }],
