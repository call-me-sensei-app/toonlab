      "sources": ["paris-implicit-blocks-2020", "mateos-mechanical-weathering-2023"],
      "evaluator": "talusInheritsSource",
      "accept": [{ "name": "gneiss source and talus", "recipe": { "lithology": "gneiss", "landform": "talus-fan", "sourceLithology": "gneiss", "sourceFormationId": "ridge-a" } }],
