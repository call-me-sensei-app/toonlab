      "sources": ["bgs-discontinuities"],
      "evaluator": "crossCuttingNeedsChronology",
      "accept": [{ "name": "joints cut beds", "recipe": { "lithology": "quartz-arenite", "fabrics": ["thin-bedding", "orthogonal-joints"], "chronology": ["deposition", "lithification", "jointing"] } }],
      "reject": [{ "name": "ambiguous beds and joints", "recipe": { "lithology": "quartz-arenite", "fabrics": ["thin-bedding", "orthogonal-joints"] } }]
    },
    {
      "id": "karst-requires-solubility-water-exposure-time",
      "claimStrength": "empirical-constraint",
      "sources": ["bgs-rock-classification"],
      "evaluator": "karstRequiresSolubilityWaterExposureTime",
      "accept": [{ "name": "humid limestone spire", "recipe": { "lithology": "micritic-limestone", "processes": ["karst-dissolution"], "environment": "humid", "landform": "karst-spire", "waterRouting": true, "exposureYears": 250000 } }],
      "reject": [{ "name": "noise-carved granite karst", "recipe": { "lithology": "granite", "processes": ["karst-dissolution"], "environment": "humid", "landform": "karst-spire" } }]
    },
    {
      "id": "tafoni-needs-material-climate-exposure",
      "claimStrength": "approximated-process",
      "sources": ["bgs-discontinuities"],
      "evaluator": "tafoniNeedsMaterialClimateExposure",
      "accept": [{ "name": "salt-weathered porous sandstone", "recipe": { "lithology": "quartz-arenite", "processes": ["salt-weathering"], "environment": "semi-arid", "porosity": 0.18, "saltExposure": 0.7, "exposureYears": 40000 } }],
      "reject": [{ "name": "instant dense quartzite tafoni", "recipe": { "lithology": "quartzite", "processes": ["salt-weathering"], "environment": "glacial", "porosity": 0.01, "saltExposure": 0, "exposureYears": 1 } }]
    },
    {
      "id": "transport-rounding-requires-detachment",
      "claimStrength": "empirical-constraint",
      "sources": ["bgs-rock-classification"],
      "evaluator": "transportRoundingRequiresDetachment",
      "accept": [{ "name": "river boulder", "recipe": { "lithology": "granite", "processes": ["transport-rounding"], "landform": "boulder", "detached": true, "transportDistanceMetres": 12000 } }],
      "reject": [{ "name": "river-rounded attached cliff", "recipe": { "lithology": "granite", "processes": ["transport-rounding"], "landform": "cliff", "detached": false } }]
    },
    {
