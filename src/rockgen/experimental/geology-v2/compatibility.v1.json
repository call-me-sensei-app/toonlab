  "contextualRules": [
    {
      "id": "bedding-requires-deposition",
      "claimStrength": "empirical-constraint",
      "sources": ["bgs-rock-classification"],
      "evaluator": "beddingRequiresDepositedUnit",
      "accept": [{ "name": "cross-bedded sandstone", "recipe": { "lithology": "quartz-arenite", "fabrics": ["cross-bedding"] } }],
      "reject": [{ "name": "bedded granite", "recipe": { "lithology": "granite", "fabrics": ["thin-bedding"] } }]
    },
    {
      "id": "cooling-columns-require-cooling-body",
      "claimStrength": "empirical-constraint",
      "sources": ["nps-columnar-jointing"],
      "evaluator": "coolingColumnsRequireCoolingBody",
      "accept": [{ "name": "basalt colonnade", "recipe": { "lithology": "basalt", "fabrics": ["cooling-columns"], "coolingBoundary": "flow-top" } }],
      "reject": [{ "name": "granite columns", "recipe": { "lithology": "granite", "fabrics": ["cooling-columns"] } }]
    },
    {
      "id": "metamorphic-fabric-requires-metamorphism",
      "claimStrength": "empirical-constraint",
      "sources": ["bgs-rock-classification"],
      "evaluator": "metamorphicFabricRequiresMetamorphism",
      "accept": [{ "name": "gneissic gneiss", "recipe": { "lithology": "gneiss", "fabrics": ["gneissic-banding"] } }],
      "reject": [{ "name": "gneissic sandstone", "recipe": { "lithology": "quartz-arenite", "fabrics": ["gneissic-banding"] } }]
    },
    {
