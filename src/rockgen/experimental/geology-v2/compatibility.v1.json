    {
      "id": "overhang-requires-stability",
      "claimStrength": "approximated-process",
      "sources": ["mateos-mechanical-weathering-2023"],
      "evaluator": "overhangRequiresStability",
      "accept": [{ "name": "checked sandstone arch", "recipe": { "lithology": "quartz-arenite", "landform": "arch", "stability": { "mode": "support-graph", "passed": true } } }],
      "reject": [{ "name": "unsupported arch", "recipe": { "lithology": "quartz-arenite", "landform": "arch" } }]
    },
